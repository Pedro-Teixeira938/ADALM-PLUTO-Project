options:
  parameters:
    author: ''
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Transmitter half of a two-Pluto OFDM link: sends 50-byte packets back to back.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ofdm_tx_pluto
    max_nouts: '0'
    output_language: python
    placement: '(0,0)'
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: OFDM TX - ADALM-PLUTO
    window_size: '1280, 1024'
  states:
    coordinate: [8, 12.0]
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '1000000'
  states:
    coordinate: [200, 12.0]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: Must match the RX flowgraph
    value: '868000000'
  states:
    coordinate: [320, 12.0]
    rotation: 0
    state: enabled
- name: pluto_uri
  id: variable
  parameters:
    comment: ''
    value: '"ip:192.168.2.1"'
  states:
    coordinate: [460, 12.0]
    rotation: 0
    state: enabled
- name: fft_len
  id: variable
  parameters:
    comment: ''
    value: '64'
  states:
    coordinate: [620, 12.0]
    rotation: 0
    state: enabled
- name: packet_len
  id: variable
  parameters:
    comment: ''
    value: '50'
  states:
    coordinate: [720, 12.0]
    rotation: 0
    state: enabled
- name: len_tag_key
  id: variable
  parameters:
    comment: ''
    value: '"packet_len"'
  states:
    coordinate: [820, 12.0]
    rotation: 0
    state: enabled
- name: occupied_carriers
  id: variable
  parameters:
    comment: ''
    value: '((-4,-3,-2,-1,1,2,3,4),)'
  states:
    coordinate: [200, 76.0]
    rotation: 0
    state: enabled
- name: pilot_carriers
  id: variable
  parameters:
    comment: ''
    value: '((-6,-5,5,6),)'
  states:
    coordinate: [400, 76.0]
    rotation: 0
    state: enabled
- name: pilot_symbols
  id: variable
  parameters:
    comment: ''
    value: '((-1,1,-1,1),)'
  states:
    coordinate: [580, 76.0]
    rotation: 0
    state: enabled
- name: tx_scale
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: TX Digital Scale
    min_len: '200'
    orient: Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.001'
    stop: '0.058'
    value: '0.04'
    widget: counter_slider
  states:
    coordinate: [200, 140.0]
    rotation: 0
    state: enabled
- name: tx_atten
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: TX Attenuation (dB)
    min_len: '200'
    orient: Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.25'
    stop: '89.75'
    value: '40'
    widget: counter_slider
  states:
    coordinate: [380, 140.0]
    rotation: 0
    state: enabled
- name: blocks_vector_source_x_0
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '()'
    type: byte
    vector: range(packet_len)
    vlen: '1'
  states:
    coordinate: [16, 300.0]
    rotation: 0
    state: enabled
- name: blocks_stream_to_tagged_stream_0
  id: blocks_stream_to_tagged_stream
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    len_tag_key: len_tag_key
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_len: packet_len
    type: byte
    vlen: '1'
  states:
    coordinate: [200, 308.0]
    rotation: 0
    state: enabled
- name: digital_ofdm_tx_0
  id: digital_ofdm_tx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    cp_len: fft_len//4
    fft_len: fft_len
    header_mod: '"BPSK"'
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    occupied_carriers: occupied_carriers
    packet_len_key: len_tag_key
    payload_mod: '"QPSK"'
    pilot_carriers: pilot_carriers
    pilot_symbols: pilot_symbols
    rolloff: '0'
    scramble_bits: 'False'
    sync_word1: 'None'
    sync_word2: 'None'
  states:
    coordinate: [440, 252.0]
    rotation: 0
    state: enabled
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: tx_scale
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    coordinate: [720, 308.0]
    rotation: 0
    state: enabled
- name: iio_fmcomms2_sink_0
  id: iio_fmcomms2_sink
  parameters:
    affinity: ''
    alias: ''
    attenuation1: tx_atten
    attenuation2: '10.0'
    bandwidth: '1000000'
    buffer_size: '32768'
    comment: "FMComms2 sink used instead of PlutoSDR Sink: same driver, but its\nattenuation callback works in GNU Radio 3.10.1 (PlutoSDR Sink's does not)."
    cyclic: 'False'
    filter: ''
    filter_source: '''Auto'''
    fpass: '0'
    fstop: '0'
    frequency: int(center_freq)
    len_tag_key: ''
    rf_port_select: '''A'''
    samplerate: int(samp_rate)
    tx1_en: 'True'
    tx2_en: 'False'
    type: fc32
    uri: pluto_uri
  states:
    coordinate: [920, 260.0]
    rotation: 0
    state: enabled
- name: tx_capture
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: TX samples as sent to the Pluto. Disable when not needed.
    file: tx_capture.cfile
    type: complex
    unbuffered: 'False'
    vlen: '1'
  states:
    coordinate: [920, 460.0]
    rotation: 0
    state: disabled
- name: tx_monitor
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nTX Monitor: counts packets leaving the OFDM Transmitter ('packet_len' tags).\nget_stats() is polled by a Function Probe to show the transmit rate.\n\"\"\"\nimport time\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self, tag='packet_len'):\n        gr.sync_block.__init__(self, name='TX Monitor', in_sig=[np.complex64], out_sig=None)\n        self.key = pmt.intern(tag)\n        self.total = 0\n        self._last = (time.time(), 0)\n\n    def work(self, input_items, output_items):\n        n = len(input_items[0])\n        start = self.nitems_read(0)\n        self.total += sum(1 for t in self.get_tags_in_range(0, start, start + n) if pmt.eq(t.key, self.key))\n        return n\n\n    def get_stats(self):\n        now, tot = time.time(), self.total\n        t0, tot0 = self._last\n        self._last = (now, tot)\n        return 'Transmitting  |  {:d} packets sent  |  {:.0f} pkt/s'.format(tot, (tot - tot0) / max(now\
      \ - t0, 1e-3))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tag: '''packet_len'''
  states:
    _io_cache: ''
    coordinate: [720, 420.0]
    rotation: 0
    state: enabled
- name: tx_stats
  id: variable_function_probe
  parameters:
    block_id: tx_monitor
    comment: ''
    function_args: ''
    function_name: get_stats
    poll_rate: '1'
    value: '"waiting for packets..."'
  states:
    coordinate: [580, 140.0]
    rotation: 0
    state: enabled
- name: tx_stats_label
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'None'
    gui_hint: ''
    label: Status
    type: string
    value: tx_stats
  states:
    coordinate: [760, 140.0]
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '1.0'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    ctrlpanel: 'False'
    fc: center_freq
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'False'
    gui_hint: ''
    label: Relative Gain
    label1: TX
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"TX Spectrum (sent to the Pluto)"'
    nconnections: '1'
    showports: 'True'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '0'
    ymin: '-100'
  states:
    coordinate: [920, 540.0]
    rotation: 0
    state: enabled
connections:
- [blocks_vector_source_x_0, '0', blocks_stream_to_tagged_stream_0, '0']
- [blocks_stream_to_tagged_stream_0, '0', digital_ofdm_tx_0, '0']
- [digital_ofdm_tx_0, '0', blocks_multiply_const_vxx_0, '0']
- [digital_ofdm_tx_0, '0', tx_monitor, '0']
- [blocks_multiply_const_vxx_0, '0', iio_fmcomms2_sink_0, '0']
- [blocks_multiply_const_vxx_0, '0', tx_capture, '0']
- [blocks_multiply_const_vxx_0, '0', qtgui_freq_sink_x_0, '0']
metadata:
  file_format: 1
