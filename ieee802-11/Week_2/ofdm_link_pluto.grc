options:
  parameters:
    author: ''
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Transmit OFDM packets over the air with an ADALM-PLUTO (TX -> RX loopback).
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ofdm_pluto_link
    max_nouts: '0'
    output_language: python
    placement: '(0,0)'
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: OFDM Link - ADALM-PLUTO
    window_size: '1280, 1024'
  states:
    coordinate: [8, 12.0]
    rotation: 0
    state: enabled
blocks:
- name: center_freq
  id: variable
  parameters:
