- name: packet_counter
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nPacket counter: counts TX packets (input 0 = OFDM TX output, 'packet_len' tags) and\ncorrectly decoded RX packets (input 1, 'rx_len' tags; ofdm_rx drops CRC failures).\nget_stats() is polled by a Function Probe to show results in the GUI.\n\"\"\"\nimport time\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n    def __init__(self, tx_tag='packet_len', rx_tag='rx_len'):\n        gr.basic_block.__init__(self, name='Packet Counter',\n                                in_sig=[np.complex64, np.uint8], out_sig=None)\n        self.tx_key = pmt.intern(tx_tag)\n        self.rx_key = pmt.intern(rx_tag)\n        self.tx_total = 0\n        self.rx_total = 0\n        self._last = (time.time(), 0, 0)\n\n    def forecast(self, noutput_items, ninputs):\n        return [1, 0]  # wait for TX samples (always flowing); RX input may be empty\n\n    def general_work(self, input_items, output_items):\n        for i, key in enumerate((self.tx_key,\
      \ self.rx_key)):\n            n = len(input_items[i])\n            if n == 0:\n                continue\n            start = self.nitems_read(i)\n            count = sum(1 for t in self.get_tags_in_range(i, start, start + n) if pmt.eq(t.key, key))\n            if i == 0:\n                self.tx_total += count\n            else:\n                self.rx_total += count\n            self.consume(i, n)\n        return 0\n\n    def get_stats(self):\n        now, tx, rx = time.time(), self.tx_total, self.rx_total\n        t0, tx0, rx0 = self._last\n        self._last = (now, tx, rx)\n        dt = max(now - t0, 1e-3)\n        dtx, drx = tx - tx0, rx - rx0\n        rate = drx / dt\n        pct = min(100.0, 100.0 * drx / dtx) if dtx > 0 else 0.0\n        return 'RX {:d} / TX {:d} packets  |  {:.0f} pkt/s  |  {:.1f}% received (last {:.1f} s)'.format(\n            rx, tx, rate, pct, dt)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    rx_tag: '''rx_len'''
    tx_tag: '''packet_len'''
  states:
    _io_cache: ''
    coordinate: [1560, 1220.0]
    rotation: 0
    state: enabled
- name: rx_capture
  id: blocks_file_sink
  parameters:
    affinity: ''
